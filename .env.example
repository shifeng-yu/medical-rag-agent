# ============================================================
# 全科医疗问诊RAG智能助手 - 环境变量配置
# ============================================================

# --- 模型路径 ---
QWEN_MODEL_PATH=/models/Qwen-14B-Chat-GPTQ-Int4
BGE_MODEL_PATH=/models/bge-m3

# --- 模型加载 ---
# 1 = GPTQ INT4 量化加载（生产 docker compose 已置 1，需 QWEN_MODEL_PATH 指向 GPTQ-Int4 权重）
# 0 = 标准 transformers 加载（默认；本地开发 / CPU / 复现即用，走通用权重目录）
USE_GPTQ=0

# --- LLM 后端（LLM 总机，见 docs/adr/0003） ---
# qwen: 真实模型（默认）; fake: 确定性假话务员（测试/CI/演示，不加载模型）
LLM_BACKEND=qwen

# --- Milvus 向量库连接 ---
# false = Docker Milvus（生产/正式环境，配合下方连接配置与 docker compose）
# true  = 嵌入式 Milvus Lite（本地开发/CI 无 Docker；首次检索自动建表，无需 setup_milvus）
USE_MILVUS_LITE=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_KB=medical_knowledge_base
MILVUS_COLLECTION_PUBMED=pubmed_literature

# --- 检索后端（milvus | milvus_lite | pgvector） ---
# 留空 = 沿用 USE_MILVUS_LITE（上方开关）；显式配置优先。
# 切 pgvector：VECTOR_BACKEND=pgvector + PG_DSN，并 docker compose --profile pgvector up -d
VECTOR_BACKEND=
PG_DSN=postgresql://medrag:medrag_dev2026@127.0.0.1:5432/medical_rag
PG_TABLE=kb_chunks
PG_POOL_MAX=8

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 数据持久化（会话/反馈/任务） ---
# 生产：mysql+pymysql://medrag:medrag_dev2026@127.0.0.1:3306/medical_rag?charset=utf8mb4
# 本地/CI：留空即落 sqlite:///volumes/app.db（零依赖，同一套模型）
DATABASE_URL=
DB_ECHO=0
DB_POOL_SIZE=5

# --- Redis（会话热缓存 + Celery broker） ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=1
CACHE_TTL_SECONDS=86400

# --- 异步任务（灌库/索引重建） ---
# inline: BackgroundTasks 进程内执行（本地开发/测试）
# celery: 投递 Redis broker，由 medical-rag-worker 执行（生产 compose）
TASK_MODE=inline

# --- 会话配置 ---
SESSION_TTL_SECONDS=86400
SESSION_MAX_TOKENS=2000
SESSION_COMPRESS_ROUNDS=4

# --- 检索配置 ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- 重试与降级 ---
MAX_RETRY_GENERATION=2
MAX_RETRY_TOOL_CALL=2

# --- LLM-Judge 阈值 ---
JUDGE_SCORE_THRESHOLD=6

# --- PubMed 离线文献路径 ---
PUBMED_OFFLINE_DIR=./data/pubmed

# --- 本地知识库路径 ---
MEDICAL_KB_DIR=./data/medical_kb
