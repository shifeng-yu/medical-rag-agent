# ============================================================
# 全科医疗问诊RAG智能助手 - 环境变量配置
# ============================================================

# --- 模型路径 ---
QWEN_MODEL_PATH=/models/Qwen-14B-Chat-GPTQ-Int4
BGE_MODEL_PATH=/models/bge-m3

# --- 模型加载 ---
# 1 = GPTQ INT4 量化加载（生产 docker compose 已置 1，需 QWEN_MODEL_PATH 指向 GPTQ-Int4 权重）
# 0 = 标准 transformers 加载（默认；本地开发 / CPU / 复现即用，走通用权重目录）
USE_GPTQ=0

# --- LLM 后端（LLM 总机，见 docs/adr/0003） ---
# qwen: 真实模型（默认）; fake: 确定性假话务员（测试/CI/演示，不加载模型）
LLM_BACKEND=qwen

# --- Milvus 向量库连接 ---
# false = Docker Milvus（生产/正式环境，配合下方连接配置与 docker compose）
# true  = 嵌入式 Milvus Lite（本地开发/CI 无 Docker；首次检索自动建表，无需 setup_milvus）
USE_MILVUS_LITE=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_KB=medical_knowledge_base
MILVUS_COLLECTION_PUBMED=pubmed_literature

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 会话配置 ---
SESSION_TTL_SECONDS=86400
SESSION_MAX_TOKENS=2000
SESSION_COMPRESS_ROUNDS=4

# --- 检索配置 ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- 重试与降级 ---
MAX_RETRY_GENERATION=2
MAX_RETRY_TOOL_CALL=2

# --- LLM-Judge 阈值 ---
JUDGE_SCORE_THRESHOLD=6

# --- PubMed 离线文献路径 ---
PUBMED_OFFLINE_DIR=./data/pubmed

# --- 本地知识库路径 ---
MEDICAL_KB_DIR=./data/medical_kb
