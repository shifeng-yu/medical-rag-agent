# ============================================================
# 全科医疗问诊RAG智能助手 - 环境变量配置
# ============================================================

# --- 模型路径 ---
QWEN_MODEL_PATH=/models/Qwen-14B-Chat-GPTQ-Int4
BGE_MODEL_PATH=/models/bge-m3

# --- Milvus 向量库连接 ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_KB=medical_knowledge_base
MILVUS_COLLECTION_PUBMED=pubmed_literature

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 会话配置 ---
SESSION_TTL_SECONDS=86400
SESSION_MAX_TOKENS=2000
SESSION_COMPRESS_ROUNDS=4

# --- 检索配置 ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- 重试与降级 ---
MAX_RETRY_GENERATION=2
MAX_RETRY_TOOL_CALL=2

# --- LLM-Judge 阈值 ---
JUDGE_SCORE_THRESHOLD=6

# --- PubMed 离线文献路径 ---
PUBMED_OFFLINE_DIR=./data/pubmed

# --- 本地知识库路径 ---
MEDICAL_KB_DIR=./data/medical_kb
